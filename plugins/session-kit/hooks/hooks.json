{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Artifact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.py\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "json=$(cat); case \"$json\" in *python3*\"<<\"*) printf '%s' \"$json\" | python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/nudge_single_edit.py\" ;; esac"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/doc_length.py\""
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/format.py\""
          },
          {
            "type": "command",
            "command": "command -v uv >/dev/null 2>&1 || exit 0; UV_PROJECT_ENVIRONMENT=\"${CLAUDE_PLUGIN_DATA:-${CLAUDE_PLUGIN_ROOT}}/venv\" uv run --quiet --frozen --project \"${CLAUDE_PLUGIN_ROOT}/tells\" session-tells hook"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "json=$(cat); case \"$json\" in *'\"bashEditDiff\"'*) printf '%s' \"$json\" | python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/format.py\"; printf '%s' \"$json\" | { command -v uv >/dev/null 2>&1 || exit 0; UV_PROJECT_ENVIRONMENT=\"${CLAUDE_PLUGIN_DATA:-${CLAUDE_PLUGIN_ROOT}}/venv\" uv run --quiet --frozen --project \"${CLAUDE_PLUGIN_ROOT}/tells\" session-tells hook; } ;; esac"
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/test_log.py\""
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/context_pressure.py\""
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/test_log.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/context_pressure.py\" stop"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/direnv_env.sh\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/pyright_env.py\"",
            "timeout": 150
          }
        ]
      }
    ],
    "CwdChanged": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/direnv_env.sh\""
          }
        ]
      }
    ],
    "FileChanged": [
      {
        "matcher": ".envrc|flake.nix|flake.lock",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/direnv_env.sh\""
          }
        ]
      }
    ]
  }
}
